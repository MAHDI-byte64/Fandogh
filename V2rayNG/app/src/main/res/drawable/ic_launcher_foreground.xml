<?xml version="1.0" encoding="utf-8"?>
<!--
  Fandogh (فندق) app icon — a hazelnut.

  Drawn on the standard 108dp adaptive-icon canvas. The nut sits inside the
  66dp safe zone (centre 18..90) so no launcher mask can clip it: body spans
  y 28..85, the husk cap y 26..55, and the stem tops out at y 14.

  Palette pairs a warm amber nut with the app's green-to-blue accent on the
  husk, so the icon reads as a hazelnut while staying in the product's colours.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft drop shadow so the nut lifts off the navy background -->
    <path
        android:pathData="M54,34 C69,34 81,46 81,62 C81,78 69,90 54,90 C39,90 27,78 27,62 C27,46 39,34 54,34 Z"
        android:fillColor="#000000"
        android:fillAlpha="0.22" />

    <!-- Nut body -->
    <path android:pathData="M54,30 C69,30 80,43 80,59 C80,75 68,87 54,87 C40,87 28,75 28,59 C28,43 39,30 54,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28" android:startY="32"
                android:endX="80" android:endY="87">
                <item android:offset="0" android:color="#F0B978" />
                <item android:offset="0.55" android:color="#D98F45" />
                <item android:offset="1" android:color="#A25F27" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Highlight on the upper-left of the nut -->
    <path
        android:pathData="M45,42 C50,37 57,36 61,38 C56,39 50,43 47,49 C45,47 44,44 45,42 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.30" />

    <!-- Vertical seam line down the nut -->
    <path
        android:pathData="M54,50 C55,61 55,72 54,83"
        android:strokeColor="#8A4E1E"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.45"
        android:strokeLineCap="round" />

    <!-- Husk cap with a scalloped lower edge -->
    <path android:pathData="M28,44 C28,33 39,24 54,24 C69,24 80,33 80,44 q-6.5,7.5 -13,0 q-6.5,7.5 -13,0 q-6.5,7.5 -13,0 q-6.5,7.5 -13,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28" android:startY="24"
                android:endX="80" android:endY="51">
                <item android:offset="0" android:color="#3FD9A0" />
                <item android:offset="0.5" android:color="#2BB6B4" />
                <item android:offset="1" android:color="#2E8FE0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sheen across the husk -->
    <path
        android:pathData="M38,44 C41,34 48,29 56,29 C50,32 44,38 42,47 C40,47 38,46 38,44 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.28" />

    <!-- Stem -->
    <path
        android:pathData="M52,27 C51,21 52,17 55,14 C58,17 57,23 56,27 Z"
        android:fillColor="#2E8FE0" />
</vector>
